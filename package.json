{
  "name": "monikey",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo root — see frontend/ and backend/ for the two independently-built packages.",
  "scripts": {
    "install:all": "npm ci --prefix frontend && npm ci --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev:api --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:backend": "npm run lint --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "test:e2e": "npm run test:e2e:mock --prefix frontend",
    "test:e2e:mock": "npm run test:e2e:mock --prefix frontend",
    "test:e2e:backend": "PLAYWRIGHT_TEST_BASE_URL=http://localhost:8080 npm run test:e2e:backend --prefix frontend",
    "test:backend:compose": "npm run test:backend:compose --prefix frontend"
  }
}
