{
  "uid": "monikey-health",
  "title": "MoniKey Health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    { "id": 1, "type": "stat", "title": "API error rate", "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "100 * rate(monikey_http_errors_total[5m]) / clamp_min(rate(monikey_http_requests_total[5m]), 1e-9)", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 5 }] } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 2, "type": "stat", "title": "Pending jobs", "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "monikey_worker_jobs_pending", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 3, "type": "stat", "title": "Dead jobs", "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "monikey_worker_jobs_dead", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 4, "type": "stat", "title": "Partial import batches", "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "monikey_import_batches_partial", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 5, "type": "timeseries", "title": "Worker job outcomes", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "rate(monikey_worker_jobs_succeeded_total[5m])", "legendFormat": "succeeded", "refId": "A" }, { "expr": "rate(monikey_worker_jobs_failed_total[5m])", "legendFormat": "failed", "refId": "B" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" } } },
    { "id": 6, "type": "timeseries", "title": "Notification backlog", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "monikey_notification_outbox_pending", "legendFormat": "pending", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" } } }
  ]
}
