// Monikey backend — Phase 1 + Phase 3 schema.
// Scope: users, sessions, preferences, categories, financial accounts, credit
// card details, transactions, transaction balance effects, goals, budgets,
// and recurring definitions.
//
// IMPORTANT: this file must stay byte-for-byte consistent with what
// `prisma/migrations/20260831000000_init/migration.sql` and
// `prisma/migrations/20260831_phase3_ledger_transactions/migration.sql` actually create.
// Every `DateTime` column is `@db.Timestamptz(6)` because the migrations
// create `TIMESTAMPTZ` columns — a bare `DateTime` would describe Prisma's
// default `timestamp(3)` (no timezone) and silently drift from the applied
// schema (QA Attempt 1, Finding 1). Verify with:
//   npx prisma migrate diff --from-schema-datamodel prisma/schema.prisma \
//     --to-url "$DATABASE_URL" --script
// which must print no `ALTER COLUMN ... SET DATA TYPE` output.
//
// This schema also cannot represent the CHECK constraints or the triggers
// the migrations add (Prisma has no declarative support for either in this
// version) — those exist ONLY in the raw migration SQL. Any future
// `prisma migrate dev` diff must be hand-audited to re-append them; see
// Database Schema.md in the Obsidian vault for the authoritative list.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  checking
  savings
  ewallet
  cash
  credit_card

  @@map("account_type")
}

enum AccountClassification {
  asset
  liability

  @@map("account_classification")
}

enum CardNetwork {
  visa
  mastercard

  @@map("card_network")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  timezone     String   @default("Asia/Manila")
  baseCurrency String   @default("PHP") @map("base_currency") @db.Char(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions           UserSession[]
  preferences        UserPreferences?
  categories         Category[]
  financialAccounts  FinancialAccount[]
  transactions       Transaction[]
  goals              Goal[]
  budgetPeriods      BudgetPeriod[]
  recurringItems     RecurringItem[]
  notificationOutbox NotificationOutbox[]
  instruments        Instrument[]
  investmentTrades   InvestmentTrade[]
  dividends          Dividend[]

  @@map("users")
}

model UserSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgent   String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // TODO(Phase 5 / JobModule): a scheduled cleanup job should periodically
  // delete rows where expires_at is in the past. Not built in Phase 2 — the
  // auth guard already refuses to authenticate an expired session (and
  // opportunistically deletes the one row it just resolved), so correctness
  // does not depend on this job; it only bounds table growth over time.
  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// NOTE (deliberate Phase-1 deviation, recorded per orchestrator sign-off —
// see the Phase 1 development log "Problems Encountered" and
// Database Schema.md): the plan's Phase 1 checklist lists only
// users/sessions/categories/accounts/cards. This table is genuinely Phase 2
// territory (settings persistence), but is included now as harmless
// pre-provisioning: it has no FK/behavioral coupling to anything Phase 1
// builds, Phase 2's AuthModule/SettingsModule will consume it unchanged, and
// removing it would require a churny down-migration for zero benefit. If
// Phase 2 needs a different shape, add a follow-up migration — do not edit
// this one.
model UserPreferences {
  userId                        String   @id @map("user_id") @db.Uuid
  billDueReminders              Boolean  @default(true) @map("bill_due_reminders")
  budgetNearLimitWarnings       Boolean  @default(true) @map("budget_near_limit_warnings")
  weeklySummaryEmail            Boolean  @default(false) @map("weekly_summary_email")
  hideCents                     Boolean  @default(false) @map("hide_cents")
  externalAiEnabled             Boolean  @default(false) @map("external_ai_enabled")
  externalOcrEnabled            Boolean  @default(false) @map("external_ocr_enabled")
  detailedAiContextEnabled      Boolean  @default(false) @map("detailed_ai_context_enabled")
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Category {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  name              String
  color             String
  budgetable        Boolean   @default(true)
  allowsIncome      Boolean   @default(false) @map("allows_income")
  allowsExpense     Boolean   @default(true) @map("allows_expense")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  budgetAllocations BudgetAllocation[]
  recurringItems RecurringItem[]

  @@index([userId])
  @@map("categories")
}

model FinancialAccount {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @map("user_id") @db.Uuid
  name                String
  institution         String?
  accountType         AccountType           @map("account_type")
  classification      AccountClassification
  currencyCode        String                @default("PHP") @map("currency_code") @db.Char(3)
  openingBalanceMinor BigInt                @default(0) @map("opening_balance_minor")
  currentBalanceMinor BigInt                @default(0) @map("current_balance_minor")
  lastFour            String?               @map("last_four")
  syncStatus          String                @default("manual") @map("sync_status")
  manual              Boolean               @default(true)
  version             Int                   @default(0)
  archivedAt          DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCardDetail CreditCardDetail?
  fromTransactions Transaction[]           @relation("TransactionFromAccount")
  toTransactions   Transaction[]           @relation("TransactionToAccount")
  balanceEffects   TransactionBalanceEffect[]
  goalContributions GoalContribution[]
  recurringItems RecurringItem[]
  investmentTrades InvestmentTrade[]

  @@index([userId])
  @@map("financial_accounts")
}

model CreditCardDetail {
  accountId          String   @id @map("account_id") @db.Uuid
  network            CardNetwork
  creditLimitMinor   BigInt   @map("credit_limit_minor")
  dueDay             Int      @map("due_day")
  minimumPaymentMinor BigInt  @default(0) @map("minimum_payment_minor")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credit_card_details")
}

enum TransactionType {
  income
  expense
  transfer

  @@map("transaction_type")
}

enum TransactionSource {
  manual
  ocr
  recurring

  @@map("transaction_source")
}

enum TransactionStatus {
  cleared
  pending

  @@map("transaction_status")
}

enum BalanceEffectRole {
  source
  destination
  expense
  income
  card_charge
  card_payment
  fee

  @@map("balance_effect_role")
}

model Transaction {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  type                  TransactionType    @map("type")
  title                 String
  categoryId            String?            @map("category_id") @db.Uuid
  goalId                String?            @map("goal_id") @db.Uuid
  fromAccountId         String?            @map("from_account_id") @db.Uuid
  toAccountId           String?            @map("to_account_id") @db.Uuid
  occurredOn            DateTime           @map("occurred_on") @db.Date
  occurredTime          DateTime?          @map("occurred_time") @db.Time
  amountMinor           BigInt             @map("amount_minor")
  feeMinor              BigInt             @default(0) @map("fee_minor")
  currencyCode          String             @default("PHP") @map("currency_code") @db.Char(3)
  source                TransactionSource
  status                TransactionStatus
  note                  String?
  idempotencyKey        String?            @map("idempotency_key")
  reversedTransactionId String?            @unique @map("reversed_transaction_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goal                Goal?                  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  fromAccount         FinancialAccount?      @relation("TransactionFromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccount           FinancialAccount?      @relation("TransactionToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  reversedTransaction Transaction?           @relation("TransactionReversal", fields: [reversedTransactionId], references: [id], onDelete: SetNull)
  reversingTransaction Transaction?          @relation("TransactionReversal")
  balanceEffects      TransactionBalanceEffect[]
  contributions       GoalContribution[]

  @@index([userId, occurredOn])
  @@index([userId, categoryId, occurredOn])
  @@unique([userId, idempotencyKey], map: "transactions_user_id_idempotency_key_idx")
  @@map("transactions")
}

model TransactionBalanceEffect {
  id                 String              @id @default(uuid()) @db.Uuid
  transactionId      String              @map("transaction_id") @db.Uuid
  accountId          String              @map("account_id") @db.Uuid
  role               BalanceEffectRole
  deltaMinor         BigInt              @map("delta_minor")
  balanceAfterMinor  BigInt              @map("balance_after_minor")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([accountId])
  @@map("transaction_balance_effects")
}

model Goal {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  name                    String
  targetMinor             BigInt   @map("target_minor")
  currentMinor            BigInt   @default(0) @map("current_minor")
  currencyCode            String   @default("PHP") @map("currency_code") @db.Char(3)
  targetDate              DateTime @map("target_date") @db.Date
  completedDate           DateTime? @map("completed_date") @db.Date
  monthlyContributionMinor BigInt? @map("monthly_contribution_minor")
  status                  String   @default("active")
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  contributions GoalContribution[]

  @@map("goals")
}

model GoalContribution {
  id              String   @id @default(uuid()) @db.Uuid
  goalId          String   @map("goal_id") @db.Uuid
  transactionId   String   @unique @map("transaction_id") @db.Uuid
  sourceAccountId String   @map("source_account_id") @db.Uuid
  amountMinor     BigInt   @map("amount_minor")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  goal          Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction   Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  sourceAccount FinancialAccount @relation(fields: [sourceAccountId], references: [id], onDelete: Restrict)

  @@index([goalId, createdAt])
  @@map("goal_contributions")
}

enum RecurringFrequency {
  weekly
  monthly
  yearly

  @@map("recurring_frequency")
}

enum RecurringStatus {
  active
  paused

  @@map("recurring_status")
}

model RecurringItem {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  merchant     String
  amountMinor  BigInt             @map("amount_minor")
  frequency    RecurringFrequency
  nextDueDate  DateTime           @map("next_due_date") @db.Date
  accountId    String             @map("account_id") @db.Uuid
  categoryId   String             @map("category_id") @db.Uuid
  autopay      Boolean            @default(false)
  status       RecurringStatus    @default(active)
  lastPaidDate DateTime?          @map("last_paid_date") @db.Date
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, nextDueDate])
  @@index([userId, status])
  @@map("recurring_items")
}

enum NotificationStatus {
  pending
  sending
  sent
  failed

  @@map("notification_status")
}

model NotificationOutbox {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  kind         String
  dedupeKey    String             @unique @map("dedupe_key")
  payload      Json
  status       NotificationStatus @default(pending)
  availableAt  DateTime           @default(now()) @map("available_at") @db.Timestamptz(6)
  sentAt       DateTime?          @map("sent_at") @db.Timestamptz(6)
  attemptCount Int                @default(0) @map("attempt_count")
  lastError    String?            @map("last_error")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([userId, kind])
  @@map("notification_outbox")
}

enum InvestmentTradeType {
  buy
  sell

  @@map("investment_trade_type")
}

model Instrument {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  ticker      String
  name        String
  assetClass  String   @map("asset_class")
  sector      String
  currencyCode String  @default("PHP") @map("currency_code") @db.Char(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades InvestmentTrade[]
  dividends Dividend[]
  quoteSnapshots QuoteSnapshot[]

  @@unique([userId, ticker])
  @@index([ticker])
  @@map("instruments")
}

model InvestmentTrade {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  instrumentId   String              @map("instrument_id") @db.Uuid
  type           InvestmentTradeType
  units          Decimal             @db.Decimal(30, 10)
  priceMinor     BigInt              @map("price_minor")
  occurredOn     DateTime            @map("occurred_on") @db.Date
  cashAccountId  String?             @map("cash_account_id") @db.Uuid
  note           String?
  idempotencyKey String?             @map("idempotency_key")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument       @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  cashAccount FinancialAccount? @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, instrumentId, occurredOn])
  @@map("investment_trades")
}

model Dividend {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  instrumentId String     @map("instrument_id") @db.Uuid
  amountMinor  BigInt     @map("amount_minor")
  occurredOn   DateTime   @map("occurred_on") @db.Date
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@index([userId, instrumentId, occurredOn])
  @@map("dividends")
}

model QuoteSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  instrumentId String   @map("instrument_id") @db.Uuid
  source       String
  priceMinor   BigInt   @map("price_minor")
  currencyCode String   @default("PHP") @map("currency_code") @db.Char(3)
  fetchedAt    DateTime @map("fetched_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([instrumentId, fetchedAt])
  @@map("quote_snapshots")
}

model BudgetPeriod {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date
  incomePoolMinor BigInt @default(0) @map("income_pool_minor")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations BudgetAllocation[]

  @@unique([userId, periodStart, periodEnd])
  @@index([userId, periodStart])
  @@map("budget_periods")
}

model BudgetAllocation {
  id            String       @id @default(uuid()) @db.Uuid
  budgetPeriodId String      @map("budget_period_id") @db.Uuid
  categoryId    String       @map("category_id") @db.Uuid
  allocatedMinor BigInt      @map("allocated_minor")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  budgetPeriod BudgetPeriod @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([budgetPeriodId, categoryId])
  @@map("budget_allocations")
}

// Plan §18: local quota budget for outbound market-data providers. One row
// per (provider, period) — `period` is a caller-defined identifier (e.g. an
// ISO date "2026-09-01" for Alpha Vantage's daily cap, or an ISO month
// "2026-09" for CoinGecko's monthly cap) so the same table serves both
// cadences without a schema change. Atomic upsert-increment via the unique
// constraint below; never a read-then-write race (QA Attempt 1, Defects 3/4).
model ExternalApiUsage {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  period     String
  operation  String
  callCount  Int      @default(0) @map("call_count")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, period, operation])
  @@map("external_api_usage")
}

// Phase 7: Daily finance snapshots for fast historical report generation.
// Materialized denormalized state: assets, liabilities, net worth, card debt as of snapshot_date.
// Built daily by a worker job; rebuildable from ledger history.
// Not authoritative — derived from transactions and market snapshots.
model DailyFinanceSnapshot {
  userId           String   @map("user_id") @db.Uuid
  snapshotDate     DateTime @map("snapshot_date") @db.Date
  assetTotalMinor  BigInt   @default(0) @map("asset_total_minor")
  liabilityTotalMinor BigInt @default(0) @map("liability_total_minor")
  netWorthMinor    BigInt   @default(0) @map("net_worth_minor")
  cardDebtMinor    BigInt   @default(0) @map("card_debt_minor")
  baseCurrency     String   @default("PHP") @map("base_currency") @db.Char(3)
  generatedAt      DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  @@id([userId, snapshotDate], map: "daily_finance_snapshots_pkey")
  @@index([userId, snapshotDate(sort: Desc)])
  @@map("daily_finance_snapshots")
}

// Phase 8: FX rate snapshots for multi-currency support.
// Persists historical FX rates by (base, quote, date, provider).
// Never overwrite historical rates — future queries for past dates will use the cached rate from that date.
// Daily worker refreshes rates only for currencies actually in use by any user.
// If provider is unavailable, return the most recently cached rate with isStale: true.
model FxRateSnapshot {
  baseCurrency   String   @map("base_currency") @db.Char(3)
  quoteCurrency  String   @map("quote_currency") @db.Char(3)
  rate           Decimal  @db.Decimal(20, 10)
  provider       String   @db.VarChar(50)
  rateDate       DateTime @map("rate_date") @db.Date
  fetchedAt      DateTime @map("fetched_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([baseCurrency, quoteCurrency, rateDate, provider], map: "fx_rate_snapshots_unique_idx")
  @@index([baseCurrency, quoteCurrency, rateDate(sort: Desc)])
  @@index([provider, rateDate(sort: Desc)])
  @@map("fx_rate_snapshots")
}
