# Copy to .env before running `docker compose ...`. Real secrets go only in
# the untracked .env — never commit real values, never put them in Obsidian.

# Application
# NOTE: compose.yaml's api/worker services explicitly set NODE_ENV=production
# in their own `environment:` block, which wins over this file — so the
# value below only matters for `npm run dev` and other non-Compose local
# runs. compose.dev.yaml sets it back to development for the Docker dev
# overlay. See Docker Deployment.md for the full precedence explanation.
NODE_ENV=development
APP_ORIGIN=http://localhost:8080
API_PORT=3000
APP_TIMEZONE=Asia/Manila
SESSION_SECURE=false
SESSION_TTL_DAYS=30
LOG_LEVEL=info

# Frontend rollout: set true to use AsyncFinanceProvider and the /api backend.
# Keep false for the deterministic mock-driven UI test/development path.
VITE_FINANCE_BACKEND=false
NGINX_DNS_RESOLVER=127.0.0.11

# Database
POSTGRES_DB=monikey
POSTGRES_USER=monikey
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://monikey:change-me@db:5432/monikey

# Integrations — Phase 1 ships with everything stubbed; no external key is
# required for the app to boot and stay healthy.
INTEGRATIONS_MODE=stub
QUOTE_PROVIDER=stub
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=
ALPHA_VANTAGE_URL=https://www.alphavantage.co/query
COINGECKO_URL=https://api.coingecko.com/api/v3/simple/price
# Local quota budgets (plan §18), enforced before any live provider call —
# never rely on the vendor's own free-tier limit alone.
ALPHA_VANTAGE_MAX_CALLS_PER_DAY=20
COINGECKO_MAX_CALLS_PER_MONTH=9000
EMAIL_PROVIDER=mailpit
MAILPIT_URL=http://mailpit:8025/api/v1/send
EMAIL_FROM=monikey@example.com
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
FRANKFURTER_MAX_CALLS_PER_DAY=100
# Phase 9: Receipt OCR (disabled by default — set OCR_PROVIDER=ocrspace to enable)
# User must opt in via settings (external_ocr_enabled) before live OCR is called.
OCR_PROVIDER=stub
OCRSPACE_API_KEY=
# Local quota budgets (plan §18) for OCR.Space free tier:
# - 450 calls/day max (default safe limit)
# - 20000 calls/month max (default safe limit)
OCRSPACE_MAX_CALLS_PER_DAY=450
OCRSPACE_MAX_CALLS_PER_MONTH=20000

GEMINI_API_KEY=
GEMINI_MODEL=
RESEND_API_KEY=

# Phase 11: Bank data aggregation (imports) — Plaid Sandbox only.
# BANK_PROVIDER: 'stub' (default, deterministic, no network) or 'plaid_sandbox' (requires keys below).
# PLAID_ENV: 'sandbox' (default, free), 'development', or 'production' (production keys required for PH banks).
# NOTE: Plaid Sandbox does not support Philippine financial institutions.
# For real Philippine data, use manual CSV/OFX import or wait for a licensed regional aggregator.
BANK_PROVIDER=stub
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_WEBHOOK_SECRET=
IMPORT_MAX_TRANSACTIONS_PER_BATCH=10000
IMPORT_MAX_CSV_FILESIZE_BYTES=5242880

FX_PROVIDER=frankfurter
EQUITY_PROVIDER=alphavantage
CRYPTO_PROVIDER=coingecko
OCR_PROVIDER=stub
AI_PROVIDER=stub
EMAIL_PROVIDER=mailpit

# Phase 10: AI provider (disabled by default — set AI_PROVIDER=gemini to enable)
# User must opt in via settings (external_ai_enabled) before live AI is called.
AI_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Local quota budgets (plan §18) for Gemini free tier:
# - 50 calls/day max (default safe limit)
# - 1000 calls/month max (default safe limit)
GEMINI_MAX_CALLS_PER_DAY=50
GEMINI_MAX_CALLS_PER_MONTH=1000

# Local email
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025

# Receipt storage
OBJECT_STORE=filesystem
RECEIPT_STORAGE_PATH=/data/receipts

# Test-only
ALLOW_TEST_CLOCK=false
